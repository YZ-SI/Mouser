{
  "version": 5,
  "active_profile": "default",
  "profiles": {
    "default": {
      "label": "Default (All Apps)",
      "mappings": {
        "middle": "none",
        "xbutton1": "alt_tab",
        "xbutton2": "alt_tab",
        "hscroll_left": "browser_back",
        "hscroll_right": "browser_forward"
      }
    },
    "Media": {
      "label": "Media",
      "apps": [
        "wmplayer.exe",
        "vlc.exe"
      ],
      "mappings": {
        "middle": "play_pause",
        "xbutton1": "alt_tab",
        "xbutton2": "alt_tab",
        "hscroll_left": "browser_back",
        "hscroll_right": "browser_forward"
      }
    }
  },
  "settings": {
    "start_minimized": true,
    "hscroll_threshold": 1,
    "start_at_login": true
  }
}